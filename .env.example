# ── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://blacklabspotsshop.me

# ── Stripe ────────────────────────────────────────────────────────────
# Without these the checkout runs in preview mode (no payment is taken).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Printify ──────────────────────────────────────────────────────────
# Create a token at printify.com → My Profile → Connections → API.
# Without these, orders are logged but not forwarded to production.
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
PRINTIFY_SEND_TO_PRODUCTION=false

# ── Order email (optional) ────────────────────────────────────────────
# Resend receipt. Verify the domain in Resend first. Without these, enable
# Stripe’s successful-payment receipts in the Dashboard instead.
RESEND_API_KEY=
ORDER_FROM_EMAIL="Black Lab Spots <orders@blacklabspotsshop.me>"
